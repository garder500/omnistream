{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Omnistream",
  "version": "0.1.0",
  "identifier": "fr.omnistream.app",
  "build": {
    "beforeDevCommand": "bun scripts/fetch-ffmpeg.ts && bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun scripts/fetch-ffmpeg.ts && bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Omnistream",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/ffmpeg"
    ],
    "resources": {
      "../docs/ffmpeg.md": "licenses/ffmpeg.md"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REMPLACER_PAR_LA_CLE_PUBLIQUE_DU_UPDATER",
      "endpoints": [
        "https://github.com/garder500/omnistream/releases/latest/download/latest.json"
      ]
    }
  }
}
